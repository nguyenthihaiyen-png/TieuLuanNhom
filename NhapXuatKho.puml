
@startuml
title BIỂU ĐỒ ACTIVITY DIAGRAM QUY TRÌNH NHẬP KHO VÀ XUẤT KHO NGUYÊN LIỆU

skinparam backgroundColor white
skinparam shadowing false
skinparam roundcorner 12

skinparam activity {
    BackgroundColor #DCEBFA
    BorderColor #789AC8
    FontColor #26364A
    FontSize 12
}

skinparam activityDiamondBackgroundColor #FCE8C3
skinparam activityDiamondBorderColor #D49A45
skinparam ArrowColor #607D9B
skinparam activityStartColor #26364A
skinparam activityEndColor #26364A

|Thủ kho|
start
:Tiếp nhận yêu cầu nhập kho hoặc xuất kho;

|Hệ thống|
if (LOẠI NGHIỆP VỤ KHO LÀ GÌ?) then (Nhập kho)

    |Nhà cung cấp|
    :Giao nguyên liệu cho cửa hàng;

    |Thủ kho|
    :Tiếp nhận nguyên liệu;
    :Kiểm tra số lượng và chất lượng;
    :Kiểm tra thông tin lô hàng;

    if (NGUYÊN LIỆU ĐẠT YÊU CẦU?) then (Có)

        :Lập phiếu nhập kho;

        |Hệ thống|
        :Kiểm tra thông tin phiếu nhập;

        if (PHIẾU NHẬP HỢP LỆ?) then (Có)
            :Xác nhận phiếu nhập;
        else (Không)
            :Thông báo phiếu nhập không hợp lệ;

            |Thủ kho|
            :Kiểm tra và chỉnh sửa phiếu nhập;

            |Hệ thống|
            :Kiểm tra lại phiếu nhập;
            :Xác nhận phiếu nhập sau chỉnh sửa;
        endif

        :Cập nhật số lượng tồn kho;
        :Lưu thông tin lô nguyên liệu;
        :Hoàn tất nhập kho;

    else (Không)

        :Thông báo nguyên liệu không đạt yêu cầu;

        |Thủ kho|
        :Lập biên bản hàng không đạt;
        :Yêu cầu nhà cung cấp đổi hoặc trả hàng;

        |Nhà cung cấp|
        :Tiếp nhận yêu cầu xử lý hàng;

        |Hệ thống|
        :Lưu thông tin hàng không đạt;

    endif

else (Xuất kho)

    |Bộ phận yêu cầu|
    :Phát sinh nhu cầu xuất nguyên liệu;
    :Gửi yêu cầu xuất kho;

    |Thủ kho|
    :Tiếp nhận yêu cầu xuất kho;
    :Lập phiếu xuất kho;

    |Hệ thống|
    if (PHIẾU XUẤT HỢP LỆ?) then (Có)

        :Kiểm tra số lượng tồn kho;

        if (SỐ LƯỢNG TỒN ĐỦ XUẤT?) then (Có)

            :Hiển thị các lô nguyên liệu;
            :Lựa chọn lô theo nguyên tắc FEFO;

            |Thủ kho|
            :Kiểm tra và xác nhận lô xuất;
            :Thực hiện xuất nguyên liệu;

            |Hệ thống|
            :Cập nhật số lượng tồn kho;

            if (TỒN KHO DƯỚI MỨC TỐI THIỂU?) then (Có)

                :Gửi cảnh báo tồn kho thấp;

                |Thủ kho|
                :Tiếp nhận cảnh báo;
                :Lập đề nghị bổ sung nguyên liệu;

                |Hệ thống|
                :Lưu đề nghị bổ sung;

            else (Không)

                :Ghi nhận số lượng tồn kho;

            endif

            :Lưu thông tin phiếu xuất;
            :Hoàn tất xuất kho;

        else (Không)

            :Thông báo số lượng tồn không đủ;

            |Thủ kho|
            :Điều chỉnh số lượng yêu cầu;
            :Chờ bổ sung nguyên liệu;

            |Hệ thống|
            :Lưu trạng thái yêu cầu xuất kho;

        endif

    else (Không)

        :Thông báo phiếu xuất không hợp lệ;

        |Thủ kho|
        :Kiểm tra và chỉnh sửa phiếu xuất;

        |Hệ thống|
        :Kiểm tra lại thông tin phiếu xuất;
        :Lưu thông tin phiếu cần kiểm tra lại;

    endif

endif

stop
@enduml
